<project>
    <modelVersion>4.0.0</modelVersion>
    <groupId>test.it</groupId>
    <artifactId>sample-app</artifactId>
    <version>1.0-SNAPSHOT</version>

    <build>
        <plugins>
            <plugin>
                <groupId>com.ghiloufi</groupId>
                <artifactId>notnull-checker-maven-plugin</artifactId>
                <version>@1.0-SNAPSHOT@</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
